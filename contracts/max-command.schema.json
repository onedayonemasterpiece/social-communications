{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onedayonemasterpiece/social-communications/contracts/max-command.schema.json",
  "title": "MAX deterministic command",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "chat", "action", "text"],
  "properties": {
    "version": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "action": {
      "enum": ["text", "schedule_text", "rich_post"]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scheduleAt": {
      "type": "string",
      "format": "date-time"
    },
    "timeZone": {
      "type": "string",
      "default": "Europe/Kaliningrad"
    },
    "verifyOnly": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "url"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": { "const": "schedule_text" }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["scheduleAt"]
      }
    },
    {
      "if": {
        "properties": {
          "action": { "const": "rich_post" }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["image", "links"]
      }
    }
  ]
}
